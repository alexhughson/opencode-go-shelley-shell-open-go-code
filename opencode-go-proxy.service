[Unit]
Description=Format-aware proxy for OpenCode Go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/opencode-go-proxy
Environment=SHELLEY_CONVERSATION_ID=c6TN4AE
Environment=LISTEN_ADDR=:8000
ExecStart=/usr/local/bin/opencode-go-proxy
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
